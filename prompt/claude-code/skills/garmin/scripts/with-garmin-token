#!/usr/bin/env bash
# Serialize access to the rotating Garmin DI token, expose it only as an
# ephemeral 0600 tokenstore, then write refreshed state back to the host-local
# token store.
#
# The store holds runtime state, not configuration. A rotating credential's
# previous generation has no recovery value -- re-authentication needs the
# password and MFA either way -- so the store is never tracked by git and never
# shared between hosts: each host owns an independent token lineage. It is not
# encrypted at rest because the decryption key would sit on the same disk, and
# the boundary already materialises the token in plaintext for every command.
# Recovery is `garmin auth`, not a stale copy.
set -euo pipefail

STORE="${GARMIN_TOKEN_STORE:-${XDG_STATE_HOME:-$HOME/.local/state}/garmin/tokens.json}"
STORE_DIR="$(dirname "$STORE")"
PYTHON_BIN="${PYTHON_BIN:-python3}"
LOCK_FILE="${GARMIN_TOKEN_LOCK:-${TMPDIR:-/tmp}/garmin-token-${UID}.lock}"

# A token is usable only if all three DI fields are present and non-empty.
# Guards both what we load and what we persist.
validate_token() {
  "$PYTHON_BIN" -c \
    'import json, pathlib, sys; data = json.loads(pathlib.Path(sys.argv[1]).read_text()); keys = ("di_token", "di_refresh_token", "di_client_id"); sys.exit(0 if isinstance(data, dict) and all(isinstance(data.get(key), str) and data[key] for key in keys) else 65)' \
    "$1"
}

[[ $# -gt 0 ]] || { echo "with-garmin-token: command required" >&2; exit 64; }

# Only mode a directory we create; an existing one is the caller's to own.
# chmod on a directory we own would otherwise mask an intentionally sealed path.
[[ -d "$STORE_DIR" ]] || { mkdir -p "$STORE_DIR"; chmod 0700 "$STORE_DIR"; }
[[ -w "$STORE_DIR" ]] || {
  echo "with-garmin-token: token store directory must be writable for rotation: $STORE_DIR" >&2
  exit 73
}
[[ ! -e "$STORE" || -w "$STORE" ]] || {
  echo "with-garmin-token: token store must be writable for rotation: $STORE" >&2
  exit 73
}

if [[ "${GARMIN_TOKEN_LOCKED:-0}" != 1 ]]; then
  set +e
  lockf -k -t 0 "$LOCK_FILE" env GARMIN_TOKEN_LOCKED=1 "$0" "$@"
  lock_status=$?
  set -e
  [[ $lock_status -ne 75 ]] || echo "Garmin token is busy; retry after the active sync finishes." >&2
  exit "$lock_status"
fi
unset GARMIN_TOKEN_LOCKED

TOKEN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/garmin-token.XXXXXX")"
TOKEN_FILE="$TOKEN_DIR/garmin_tokens.json"
ORIGINAL_HASH=""

persist_token() {
  local current_hash staged
  [[ -f "$TOKEN_FILE" ]] || return 0
  current_hash="$(shasum -a 256 "$TOKEN_FILE" | cut -d ' ' -f 1)"
  [[ "$current_hash" != "$ORIGINAL_HASH" ]] || return 0
  validate_token "$TOKEN_FILE" || return $?
  # Same directory as the store, so the rename is atomic: a crash mid-write can
  # never leave a truncated credential behind.
  staged="$(mktemp "$STORE.XXXXXX")"
  chmod 0600 "$staged"
  cat "$TOKEN_FILE" > "$staged" || { rm -f "$staged"; return 74; }
  mv -f "$staged" "$STORE" || { rm -f "$staged"; return 74; }
  echo "Garmin token refreshed and persisted to $STORE." >&2
}

finalize() {
  local status=$?
  local persist_status=0
  trap - EXIT
  persist_token || persist_status=$?
  rm -f "$TOKEN_FILE"
  rmdir "$TOKEN_DIR" 2>/dev/null || true
  [[ $status -ne 0 ]] && exit "$status"
  exit "$persist_status"
}

trap finalize EXIT
export GARMIN_TOKEN_PATH="$TOKEN_FILE"
umask 077
# A missing store is the bootstrap case: `garmin auth` mints the first token
# into the ephemeral path and the boundary persists it on exit.
if [[ -e "$STORE" ]]; then
  cat "$STORE" > "$TOKEN_FILE"
  validate_token "$TOKEN_FILE"
  ORIGINAL_HASH="$(shasum -a 256 "$TOKEN_FILE" | cut -d ' ' -f 1)"
else
  echo "with-garmin-token: no token store at $STORE; run 'garmin auth' to mint one." >&2
fi

export GARMIN_TOKEN_DIR="$TOKEN_DIR"
export GARMINTOKENS="$TOKEN_FILE"
"$@"
