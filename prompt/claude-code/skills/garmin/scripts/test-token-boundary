#!/usr/bin/env bash
# Small dependency-free regression check for refresh-token writeback semantics.
set -euo pipefail

BOUNDARY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/with-garmin-token"
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/garmin-token-test.XXXXXX")"
STATE="$ROOT/state.json"
SET_COUNT="$ROOT/set-count"
FAKE_SOPS="$ROOT/sops"
CHILD="$ROOT/child"
LOCK="$ROOT/lock"
OLD='{"di_token":"old","di_refresh_token":"old-refresh","di_client_id":"client"}'
NEW='{"di_token":"new","di_refresh_token":"new-refresh","di_client_id":"client"}'

cleanup() {
  find "$ROOT" -type f -delete
  rmdir "$ROOT"
}
trap cleanup EXIT

cat > "$FAKE_SOPS" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  decrypt) cat "$TEST_TOKEN_STATE" ;;
  set)
    [[ "${FAKE_SET_FAIL:-0}" != 1 ]] || { cat >/dev/null; exit 55; }
    python3 -c 'import json, os, pathlib, sys; pathlib.Path(os.environ["TEST_TOKEN_STATE"]).write_text(json.load(sys.stdin))'
    printf x >> "$TEST_SET_COUNT"
    ;;
  *) exit 64 ;;
esac
SH

cat > "$CHILD" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ "${CHILD_TOKEN_VALUE:-UNCHANGED}" == UNCHANGED ]] || printf '%s' "$CHILD_TOKEN_VALUE" > "$GARMINTOKENS"
printf '%s %s\n' "$GARMINTOKENS" "$(stat -f '%Lp' "$GARMINTOKENS")" > "${CHILD_OBSERVATION:-/dev/null}"
sleep "${CHILD_SLEEP:-0}"
exit "${CHILD_EXIT:-0}"
SH
chmod 0755 "$FAKE_SOPS" "$CHILD"

run_boundary() {
  TEST_TOKEN_STATE="$STATE" TEST_SET_COUNT="$SET_COUNT" SOPS_BIN="$FAKE_SOPS" \
    GARMIN_SECRET="$ROOT/unused.yaml" GARMIN_TOKEN_LOCK="$LOCK" \
    "$BOUNDARY" "$CHILD"
}

printf '%s' "$OLD" > "$STATE"; : > "$SET_COUNT"
CHILD_OBSERVATION="$ROOT/no-change" run_boundary
[[ ! -s "$SET_COUNT" && "$(cat "$STATE")" == "$OLD" ]]
read -r ephemeral_path mode < "$ROOT/no-change"
[[ "$mode" == 600 && ! -e "$ephemeral_path" ]]

printf '%s' "$OLD" > "$STATE"; : > "$SET_COUNT"
CHILD_TOKEN_VALUE="$NEW" run_boundary
[[ "$(cat "$SET_COUNT")" == x && "$(cat "$STATE")" == "$NEW" ]]

printf '%s' "$OLD" > "$STATE"; : > "$SET_COUNT"
set +e; CHILD_TOKEN_VALUE="$NEW" CHILD_EXIT=42 run_boundary; status=$?; set -e
[[ $status -eq 42 && "$(cat "$SET_COUNT")" == x && "$(cat "$STATE")" == "$NEW" ]]

printf '%s' "$OLD" > "$STATE"; : > "$SET_COUNT"
set +e; CHILD_TOKEN_VALUE='{}' run_boundary; status=$?; set -e
[[ $status -ne 0 && ! -s "$SET_COUNT" && "$(cat "$STATE")" == "$OLD" ]]

printf '%s' "$OLD" > "$STATE"; : > "$SET_COUNT"
set +e; CHILD_TOKEN_VALUE="$NEW" FAKE_SET_FAIL=1 run_boundary; status=$?; set -e
[[ $status -eq 55 && ! -s "$SET_COUNT" && "$(cat "$STATE")" == "$OLD" ]]

printf '%s' "$OLD" > "$STATE"; : > "$SET_COUNT"
CHILD_SLEEP=2 run_boundary & first_pid=$!
sleep 0.2
set +e; run_boundary; status=$?; set -e
wait "$first_pid"
[[ $status -eq 75 ]]

echo "token-boundary-test: ok"
