#!/usr/bin/env bash
# Small dependency-free regression check for refresh-token writeback semantics.
set -euo pipefail

BOUNDARY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/with-garmin-token"
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/garmin-token-test.XXXXXX")"
STORE_DIR="$ROOT/state"
STORE="$STORE_DIR/tokens.json"
CHILD="$ROOT/child"
LOCK="$ROOT/lock"
OLD='{"di_token":"old","di_refresh_token":"old-refresh","di_client_id":"client"}'
NEW='{"di_token":"new","di_refresh_token":"new-refresh","di_client_id":"client"}'

cleanup() {
  chmod -R u+rwX "$ROOT" 2>/dev/null || true
  find "$ROOT" -type f -delete
  find "$ROOT" -depth -type d -exec rmdir {} +
}
trap cleanup EXIT

cat > "$CHILD" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ "${CHILD_TOKEN_VALUE:-UNCHANGED}" == UNCHANGED ]] || printf '%s' "$CHILD_TOKEN_VALUE" > "$GARMINTOKENS"
printf '%s %s\n' "$GARMINTOKENS" "$(stat -f '%Lp' "$GARMINTOKENS")" > "${CHILD_OBSERVATION:-/dev/null}"
sleep "${CHILD_SLEEP:-0}"
exit "${CHILD_EXIT:-0}"
SH
chmod 0755 "$CHILD"
mkdir -p "$STORE_DIR"

run_boundary() {
  GARMIN_TOKEN_STORE="$STORE" GARMIN_TOKEN_LOCK="$LOCK" "$BOUNDARY" "$CHILD"
}

# A store that cannot be replaced must stop before the child observes a token.
printf '%s' "$OLD" > "$STORE"
chmod 0444 "$STORE"
set +e
CHILD_OBSERVATION="$ROOT/read-only-store" run_boundary
status=$?
set -e
chmod 0600 "$STORE"
[[ $status -eq 73 && ! -e "$ROOT/read-only-store" && "$(cat "$STORE")" == "$OLD" ]]

# The atomic rename needs a writable directory, not just a writable file.
chmod 0500 "$STORE_DIR"
set +e
CHILD_OBSERVATION="$ROOT/read-only-dir" run_boundary
status=$?
set -e
chmod 0700 "$STORE_DIR"
[[ $status -eq 73 && ! -e "$ROOT/read-only-dir" ]]

# Unchanged token: no write, and the ephemeral copy is 0600 and gone afterwards.
printf '%s' "$OLD" > "$STORE"
before="$(stat -f '%m %z' "$STORE")"
CHILD_OBSERVATION="$ROOT/no-change" run_boundary
[[ "$(cat "$STORE")" == "$OLD" && "$(stat -f '%m %z' "$STORE")" == "$before" ]]
read -r ephemeral_path mode < "$ROOT/no-change"
[[ "$mode" == 600 && ! -e "$ephemeral_path" ]]

# Refreshed token is persisted, and the store keeps 0600.
printf '%s' "$OLD" > "$STORE"
CHILD_TOKEN_VALUE="$NEW" run_boundary
[[ "$(cat "$STORE")" == "$NEW" && "$(stat -f '%Lp' "$STORE")" == 600 ]]

# A failing command still rotated the token upstream; persist it, keep its status.
printf '%s' "$OLD" > "$STORE"
set +e; CHILD_TOKEN_VALUE="$NEW" CHILD_EXIT=42 run_boundary; status=$?; set -e
[[ $status -eq 42 && "$(cat "$STORE")" == "$NEW" ]]

# An incomplete token must never replace a working one.
printf '%s' "$OLD" > "$STORE"
set +e; CHILD_TOKEN_VALUE='{}' run_boundary; status=$?; set -e
[[ $status -ne 0 && "$(cat "$STORE")" == "$OLD" ]]

# Bootstrap: no store yet, `garmin auth` mints the first token through the boundary.
rm -f "$STORE"
CHILD_TOKEN_VALUE="$NEW" run_boundary
[[ "$(cat "$STORE")" == "$NEW" && "$(stat -f '%Lp' "$STORE")" == 600 ]]

# Bootstrap creates the store directory at 0700 when it is absent.
rm -rf "$STORE_DIR"
CHILD_TOKEN_VALUE="$NEW" run_boundary
[[ "$(stat -f '%Lp' "$STORE_DIR")" == 700 && "$(cat "$STORE")" == "$NEW" ]]

# No staging file may survive a completed run.
[[ -z "$(find "$STORE_DIR" -name 'tokens.json.*' -print -quit)" ]]

# Concurrent runs serialise; the loser reports busy instead of racing the store.
printf '%s' "$OLD" > "$STORE"
CHILD_SLEEP=2 run_boundary & first_pid=$!
sleep 0.2
set +e; run_boundary; status=$?; set -e
wait "$first_pid"
[[ $status -eq 75 ]]

echo "token-boundary-test: ok"
