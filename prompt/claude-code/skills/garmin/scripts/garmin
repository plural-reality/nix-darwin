#!/usr/bin/env bash
# Garmin skill entrypoint. with-garmin-token is the only decryption/writeback
# boundary; the Python client receives only an ephemeral tokenstore path.
#
# Usage: garmin <subcommand> [args...]   (run `garmin help` for the list)
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$SKILL_DIR/scripts/garmin.py"
WITH_TOKEN="$SKILL_DIR/scripts/with-garmin-token"
GARMINCONNECT_VERSION="0.3.8"
GARMIN_FIT_SDK_VERSION="21.208.0"

[ "${1:-}" = "help" ] && {
  echo "garmin <cmd> [args]  — auth | recent [n] | last | activity <id> | details <id> | splits <id> |"
  echo "  weather <id> | fit <id> | sleep [date] | stress [date] | steps [date] | hrv [date] |"
  echo "  rhr [date] | bodybattery [start] [end] | stats [date] | summary [date] | readiness [date] |"
  echo "  status [date] | spo2 [date] | respiration [date] | weight [start] [end] | devices |"
  echo "  profile | raw <connectapi-path>      (dates: YYYY-MM-DD, default today)"
  exit 0
}

[[ "${1:-}" == "auth" ]] &&
  exec "$SKILL_DIR/scripts/garmin-auth"

exec "$WITH_TOKEN" \
  uv run --quiet \
    --with "garminconnect==$GARMINCONNECT_VERSION" \
    --with "garmin-fit-sdk==$GARMIN_FIT_SDK_VERSION" \
    python "$PY" "$@"
